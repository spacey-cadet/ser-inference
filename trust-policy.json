{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Principal": {
                "Federated": "arn:aws:iam::395249043027:oidc-provider/token.actions.githubusercontent.com"
            },
            "Action": "sts:AssumeRoleWithWebIdentity",
            "Condition": {
                "StringEquals": {
                    "token.actions.githubusercontqqent.com:aud": "sts.amazonaws.com",
                    "token.actions.githubusercontent.com:repository": "spacey-cadet/ser-inference"
                    },
                "StringLike": {
                    "token.actions.githubusercontent.com:sub": "repo:spacey-cadet/ser-inference:*"
                }
            }
        }
    ]
}
